<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>com.dylan.localai</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/dylan-local/venv/bin/python</string>
		<string>__HOME__/dylan-local/server.py</string>
	</array>
	<key>WorkingDirectory</key><string>__HOME__/dylan-local</string>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key><true/>
	<key>ProcessType</key><string>Interactive</string>
	<key>StandardOutPath</key><string>__HOME__/dylan-local/server.log</string>
	<key>StandardErrorPath</key><string>__HOME__/dylan-local/server.log</string>
</dict>
</plist>
