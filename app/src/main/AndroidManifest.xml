<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 系統語音辨識服務要求呼叫方持有麥克風權限（即使只是讀檔案） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 手機麥克風錄音（前台服務） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 录音的 GPS 戳记（开始录音时的位置）；不给权限也能录音 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 手表录音时由手机定位（App 在背景）需要「一律允許」；使用者在设定里自己开 -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- 手錶遙控開始手機錄音：允許從背景開啟透明畫面（Android 14 起背景不能直接開麥克風） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 手機鎖屏時：像鬧鐘 / 來電一樣用全螢幕通知直接開啟錄音畫面，不用解鎖或點通知 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 自動整理通話錄音：讀取電話 App 存的通話錄音檔 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 饮食同步到健康：只写入营养（热量、三大营养素），不读任何健康资料 -->
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" />

    <!-- Android 11+ 要能找到系统语音识别服务 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- 三星錄音機（Galaxy AI 轉錄 / 摘要） -->
        <package android:name="com.sec.android.app.voicenote" />
        <!-- Health Connect（Android 13 以下是独立 App）与 Samsung Health -->
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.sec.android.app.shealth" />
    </queries>

    <!-- 大D的主機在使用者家里 / 固定 IP，只有 http（没有网域可以申请凭证） -->
    <application
        android:name=".WristAiApp"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.WristAI_Project">
        <!-- 桌面小工具：錄音鍵、今天的數字、捷徑（HomeWidget） -->
        <receiver android:name=".HomeWidget" android:exported="false" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_home_info" />
        </receiver>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.WristAI_Project"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App 捷徑：開始 / 停止錄音、記錄飲食、唸最新報告、唸今天待辦（車用；見 CarShortcuts） -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- 從錄音機等 App 分享音檔進來 -->
            <!-- 大D的主機配对：dylan://pair?url=…&lan=…&code=…（相机扫主机配对页的 QR 码） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dylan" android:host="pair" />
            </intent-filter>
            <!-- 遠距對話的邀請：dylan://talk?url=…&lan=…&room=…&code=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dylan" android:host="talk" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- Health Connect 授权画面里「隱私權政策」连结：说明大D写入什么 -->
        <activity
            android:name=".HealthPrivacyActivity"
            android:exported="true"
            android:theme="@style/Theme.WristAI_Project">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- Android 14 起：系统「健康」设定里的权限说明 -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".HealthPrivacyActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- 手錶遙控開始手機錄音的透明跳板畫面 -->
        <activity
            android:name=".RemoteRecordActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.WristAI_Project.Transparent" />

        <!-- 開機後重新監看通話錄音 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 手機麥克風錄音 -->
        <!-- 車機畫面（Android Auto 媒體類）：今天（念待辦、念最新報告、錄音）、報告清單；只讓 Android Auto 與系統瀏覽 -->
        <service
            android:name=".CarMediaService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <!-- 懸浮即時翻譯（浮在其他 App 上的字幕框；麥克風前景服務） -->
        <service
            android:name=".FloatingCaptionService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name=".PhoneRecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone|location" />

        <!-- 接收手表传来的录音（App 没开着也会被系统唤起） -->
        <service
            android:name=".AudioReceiverService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:host="*"
                    android:pathPrefix="/wristai/audio"
                    android:scheme="wear" />
                <!-- 长会议边录边传的分段 -->
                <data
                    android:host="*"
                    android:pathPrefix="/wristai/seg"
                    android:scheme="wear" />
            </intent-filter>
            <!-- 手錶遙控手機錄音 -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/wristai/phone_rec"
                    android:scheme="wear" />
            </intent-filter>
            <!-- 手錶傳來錄音的 GPS 戳記 -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/wristai/geo"
                    android:scheme="wear" />
            </intent-filter>
            <!-- 手錶要某筆錄音的完整報告 -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/wristai/detail"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- WorkManager 在 Android 11 及以下用前台服务跑加急任务 -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
            <!-- 「檔案」分页分享录音档（res/xml/file_paths.xml：只开放 cache/share/） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
